<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- OMEGA Design System v1: shared component styling. -->
    <style name="TermuxAlertDialogStyle" parent="@android:style/Theme.Material.Light.Dialog.Alert">
        <item name="android:colorAccent">@color/omega_accent</item>
    </style>

    <style name="TermuxActivity.Drawer.ButtonBarStyle.Light" parent="@style/Widget.MaterialComponents.Button.TextButton">
        <item name="android:textColor">@color/black</item>
        <item name="android:minHeight">@dimen/omega_touch_target</item>
    </style>

    <style name="TermuxActivity.Drawer.ButtonBarStyle.Dark" parent="@style/Widget.MaterialComponents.Button.TextButton">
        <item name="android:textColor">@color/omega_on_background</item>
        <item name="android:minHeight">@dimen/omega_touch_target</item>
    </style>

    <style name="Omega.Component.Button" parent="@style/Widget.MaterialComponents.Button.TextButton">
        <item name="android:minHeight">@dimen/omega_touch_target</item>
        <item name="android:minWidth">@dimen/omega_touch_target</item>
    </style>

</resources>
